{
  "name": "enterprise-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.3.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @enterprise-hub/api --filter @enterprise-hub/web dev",
    "dev:api": "pnpm --filter @enterprise-hub/api dev",
    "dev:web": "pnpm --filter @enterprise-hub/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @enterprise-hub/api test:e2e",
    "prisma:generate": "dotenv -e .env -- pnpm --filter @enterprise-hub/api prisma:generate",
    "prisma:migrate": "dotenv -e .env -- pnpm --filter @enterprise-hub/api prisma:migrate",
    "prisma:seed": "dotenv -e .env -- pnpm --filter @enterprise-hub/api prisma:seed",
    "prisma:studio": "dotenv -e .env -- pnpm --filter @enterprise-hub/api prisma:studio"
  },
  "devDependencies": {
    "dotenv-cli": "11.0.0"
  }
}
